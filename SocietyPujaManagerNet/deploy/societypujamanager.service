[Unit]
Description=Society Puja Manager .NET API
After=network.target

[Service]
WorkingDirectory=/var/www/societypujamanager
ExecStart=/usr/bin/dotnet /var/www/societypujamanager/SocietyPujaManagerNet.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=societypujamanager
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5000

[Install]
WantedBy=multi-user.target
